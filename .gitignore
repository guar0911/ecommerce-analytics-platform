# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# --- Secrets / environment variables ---
# Never commit actual .env files -- only the .env.example templates
.env
.env.*
!.env.example
!.env.*.example

# --- Raw data (downloaded from Kaggle, not ours to redistribute, and huge) ---
oltp/raw_data/

# --- dbt generated artifacts ---
etl/olist_analytics/target/
etl/olist_analytics/dbt_packages/
etl/olist_analytics/logs/
etl/olist_analytics/.user.yml

# --- Airflow generated logs ---
etl/logs/*
!etl/logs/.gitkeep

# --- MLflow / monitoring generated reports (regenerable, not source) ---
mlops/monitoring_reports/
mlflow.db

# --- Chroma vector store (regenerable binary index, not source) ---
llm_rag/chroma_db/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
